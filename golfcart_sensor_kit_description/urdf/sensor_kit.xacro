<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">
  <xacro:macro name="sensor_kit_macro" params="parent x y z roll pitch yaw">
    <xacro:include filename="$(find imu_description)/urdf/imu.xacro"/>
    <xacro:arg name="gpu" default="false"/>
    <xacro:arg name="config_dir" default="$(find golfcart_sensor_kit_description)/config"/>

    <xacro:property name="sensor_kit_base_link" default="sensor_kit_base_link"/>

    <joint name="${sensor_kit_base_link}_joint" type="fixed">
      <origin rpy="${roll} ${pitch} ${yaw}" xyz="${x} ${y} ${z}"/>
      <parent link="${parent}"/>
      <child link="${sensor_kit_base_link}"/>
    </joint>
    <link name="${sensor_kit_base_link}">
      <origin rpy="0 0 0" xyz="0 0 0"/>
    </link>

    <!-- sensor -->
    <xacro:property name="calibration" value="${xacro.load_yaml('$(arg config_dir)/sensor_kit_calibration.yaml')}"/>

    <!-- VLP lidar -->
    <joint name="lidar_joint" type="fixed">
      <origin  
        xyz="${calibration['sensor_kit_base_link']['vlp32c']['x']}
             ${calibration['sensor_kit_base_link']['vlp32c']['y']}
             ${calibration['sensor_kit_base_link']['vlp32c']['z']}"
        rpy="${calibration['sensor_kit_base_link']['vlp32c']['roll']}
             ${calibration['sensor_kit_base_link']['vlp32c']['pitch']}
             ${calibration['sensor_kit_base_link']['vlp32c']['yaw']}"
      />
      <parent link="sensor_kit_base_link"/>
      <child link="velodyne"/>
    </joint>
    
    <link name="velodyne">
      <inertial>
        <mass value="0.1"/>
        <origin xyz="0 0 0"/>
        <inertia ixx="0.1" ixy="0" ixz="0" iyy="0.1" iyz="0" izz="0.1"/>
      </inertial>
    </link>

    <!-- Falcon lidar -->
    <joint name="falcon_lidar_joint" type="fixed">
      <origin  
        xyz="${calibration['sensor_kit_base_link']['falcon']['x']}
             ${calibration['sensor_kit_base_link']['falcon']['y']}
             ${calibration['sensor_kit_base_link']['falcon']['z']}"
        rpy="${calibration['sensor_kit_base_link']['falcon']['roll']}
             ${calibration['sensor_kit_base_link']['falcon']['pitch']}
             ${calibration['sensor_kit_base_link']['falcon']['yaw']}"
      />
      <parent link="sensor_kit_base_link"/>
      <child link="seyond"/>
    </joint>
    
    <link name="seyond">
      <inertial>
        <mass value="0.1"/>
        <origin xyz="0 0 0"/>
        <inertia ixx="0.1" ixy="0" ixz="0" iyy="0.1" iyz="0" izz="0.1"/>
      </inertial>
    </link>
    
    <!-- imu -->
    <joint name="imu_joint" type="fixed">
      <origin
        xyz="${calibration['sensor_kit_base_link']['imu_link']['x']}
             ${calibration['sensor_kit_base_link']['imu_link']['y']}
             ${calibration['sensor_kit_base_link']['imu_link']['z']}"
        rpy="${calibration['sensor_kit_base_link']['imu_link']['roll']}
             ${calibration['sensor_kit_base_link']['imu_link']['pitch']}
             ${calibration['sensor_kit_base_link']['imu_link']['yaw']}"
      />
      <parent link="sensor_kit_base_link"/>
      <child link="imu_link"/>
    </joint>

    <link name="imu_link">
      <inertial>
        <mass value="0.1"/>
        <origin xyz="0 0 0"/>
        <inertia ixx="0.1" ixy="0" ixz="0" iyy="0.1" iyz="0" izz="0.1"/>
      </inertial>
    </link>

    <!-- gnss -->
    <joint name="gnss_joint" type="fixed">
      <origin
        xyz="${calibration['sensor_kit_base_link']['gnss_base_link']['x']}
             ${calibration['sensor_kit_base_link']['gnss_base_link']['y']}
             ${calibration['sensor_kit_base_link']['gnss_base_link']['z']}"
        rpy="${calibration['sensor_kit_base_link']['gnss_base_link']['roll']}
             ${calibration['sensor_kit_base_link']['gnss_base_link']['pitch']}
             ${calibration['sensor_kit_base_link']['gnss_base_link']['yaw']}"
      />
      <parent link="sensor_kit_base_link"/>
      <child link="gnss_base_link"/>
    </joint> 
    <link name="gnss_base_link">
      <inertial>
        <mass value="0.1"/>
        <origin xyz="0 0 0"/>
        <inertia ixx="0.1" ixy="0" ixz="0" iyy="0.1" iyz="0" izz="0.1"/>
      </inertial>
    </link>


    <!-- TIER IV GMSL cameras.

         Each has two frames. The body frame, camera_NAME, is where the camera
         is bolted and is what sensor_kit_calibration.yaml measures: x forward,
         y left, z up, like every other frame on the vehicle. The optical
         frame, camera_NAME_optical_link, is that same point turned into the
         convention every projection uses (x right, y down, z along the view
         direction), which is what REP-103 asks image data to be stamped with
         and what the drivers now stamp. See camera_NAME.yaml.

         Keeping both matters. A mounting measurement is taken in the body
         frame and would be unreadable written optically; a projection is done
         in the optical frame and comes out ninety degrees wrong if handed the
         body one. The fixed rotation between them carries no calibration and
         never changes.
    -->
    <joint name="camera_left_joint" type="fixed">
        <origin       
        xyz="${calibration['sensor_kit_base_link']['camera_left']['x']}
             ${calibration['sensor_kit_base_link']['camera_left']['y']}
             ${calibration['sensor_kit_base_link']['camera_left']['z']}"
        rpy="${calibration['sensor_kit_base_link']['camera_left']['roll']}
             ${calibration['sensor_kit_base_link']['camera_left']['pitch']}
             ${calibration['sensor_kit_base_link']['camera_left']['yaw']}"
            />
        <parent link="sensor_kit_base_link"/>
        <child link="camera_left"/>
    </joint>
    <link name="camera_left"/>

    <joint name="camera_left_optical_joint" type="fixed">
        <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>
        <parent link="camera_left"/>
        <child link="camera_left_optical_link"/>
    </joint>
    <link name="camera_left_optical_link"/>

    <joint name="camera_rear_joint" type="fixed">
        <origin       
        xyz="${calibration['sensor_kit_base_link']['camera_rear']['x']}
             ${calibration['sensor_kit_base_link']['camera_rear']['y']}
             ${calibration['sensor_kit_base_link']['camera_rear']['z']}"
        rpy="${calibration['sensor_kit_base_link']['camera_rear']['roll']}
             ${calibration['sensor_kit_base_link']['camera_rear']['pitch']}
             ${calibration['sensor_kit_base_link']['camera_rear']['yaw']}"
            />
        <parent link="sensor_kit_base_link"/>
        <child link="camera_rear"/>
    </joint>
    <link name="camera_rear"/>

    <joint name="camera_rear_optical_joint" type="fixed">
        <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>
        <parent link="camera_rear"/>
        <child link="camera_rear_optical_link"/>
    </joint>
    <link name="camera_rear_optical_link"/>

    <joint name="camera_right_joint" type="fixed">
        <origin       
        xyz="${calibration['sensor_kit_base_link']['camera_right']['x']}
             ${calibration['sensor_kit_base_link']['camera_right']['y']}
             ${calibration['sensor_kit_base_link']['camera_right']['z']}"
        rpy="${calibration['sensor_kit_base_link']['camera_right']['roll']}
             ${calibration['sensor_kit_base_link']['camera_right']['pitch']}
             ${calibration['sensor_kit_base_link']['camera_right']['yaw']}"
            />
        <parent link="sensor_kit_base_link"/>
        <child link="camera_right"/>
    </joint>
    <link name="camera_right"/>

    <joint name="camera_right_optical_joint" type="fixed">
        <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>
        <parent link="camera_right"/>
        <child link="camera_right_optical_link"/>
    </joint>
    <link name="camera_right_optical_link"/>

    <!--
      ZED X mounting point only. The camera's internal geometry
      (zed_camera_center, the two lens frames, the optical frames) is published
      by a separate robot_state_publisher in zed.launch.xml, fed the vendor's
      zed_descr.urdf.xacro. Do not instantiate zed_macro here as well - that
      would give every one of those edges two publishers.
    -->
    <joint name="zed_camera_joint" type="fixed">
        <origin
        xyz="${calibration['sensor_kit_base_link']['zed_camera_link']['x']}
             ${calibration['sensor_kit_base_link']['zed_camera_link']['y']}
             ${calibration['sensor_kit_base_link']['zed_camera_link']['z']}"
        rpy="${calibration['sensor_kit_base_link']['zed_camera_link']['roll']}
             ${calibration['sensor_kit_base_link']['zed_camera_link']['pitch']}
             ${calibration['sensor_kit_base_link']['zed_camera_link']['yaw']}"
            />
        <parent link="sensor_kit_base_link"/>
        <child link="zed_camera_link"/>
    </joint>
    <link name="zed_camera_link"/>

  </xacro:macro>
</robot>
