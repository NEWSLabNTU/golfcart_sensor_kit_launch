<launch>
  <!--
    ZED X stereo camera driver. Reached from camera.launch.xml with
    camera_model:=zedx, which on this vehicle runs on the orin (slave) host.

    zed_camera.launch.py is deliberately NOT included: it computes its
    LoadComposableNodes target as an absolute string before any namespace push is
    applied, while the container action itself IS pushed, so the two disagree and
    the component silently never loads. We build the container and load the
    component ourselves instead, landing topics at /sensing/camera/zed/*.

    For the same reason there is no push-ros-namespace here: both namespaces
    below are absolute. With a push, the LoadComposableNodes action sits in a
    nested scope and its wait for the container's load_node service never
    completes when this file is included from a conditional group (as
    camera.launch.xml does).

    Operational notes:
      * The ZED node needs OpenGL hardware acceleration - plain VNC breaks it.
      * If the GMSL link wedges ("ZEDX#0#0#FROZEN"), recover with
        `sudo service zed_x_daemon restart; sleep 25`. Restarting nvargus-daemon
        alone is not sufficient.

    See docs/design/zed_camera_integration.md.
  -->
  <arg name="zed_camera_name" default="zed" description="Camera name; prefixes every zed frame and the topic namespace"/>
  <arg name="zed_camera_model" default="zedx" description="ZED model: zedx, zedxm, zed2i, ..."/>
  <arg name="camera_ns" default="/sensing/camera" description="Absolute parent namespace"/>

  <!--
    Stereo video for the orin's bag: the rectified left and right images,
    H.264 encoded on the Orin's NVENC by Isaac ROS, published as
    sensor_msgs/CompressedImage (format h264) on
      left/color/rect/image/h264 and right/color/rect/image/h264.
    Needs the setup step isaac-h264-encoder on the orin; with this false
    nothing here references Isaac ROS, so a host without it still launches.
    The width and height must match what the ZED publishes: HD1200 grab,
    pub_resolution NATIVE (zedx.yaml, common_stereo.yaml).
  -->
  <arg name="zed_stereo_video" default="false" description="Publish H.264 left/right rectified streams"/>
  <arg name="zed_video_width" default="1920"/>
  <arg name="zed_video_height" default="1200"/>

  <!--
    Parameter layering, last one winning. Everything tunable lives in
    zed.param.yaml; only camera_name and camera_model are set inline below,
    because they are also substituted into namespaces and the URDF command.
  -->
  <let name="zed_common_config" value="$(find-pkg-share zed_wrapper)/config/common_stereo.yaml"/>
  <let name="zed_model_config" value="$(find-pkg-share zed_wrapper)/config/$(var zed_camera_model).yaml"/>
  <let name="zed_override_config" value="$(find-pkg-share golfcart_sensor_kit_launch)/config/zed.param.yaml"/>

  <group>
    <node_container pkg="rclcpp_components" exec="component_container_isolated"
                    name="zed_container" namespace="$(var camera_ns)/$(var zed_camera_name)">
      <param name="use_multi_threaded_executor" value="true"/>
    </node_container>

    <load_composable_node target="$(var camera_ns)/$(var zed_camera_name)/zed_container">
      <composable_node pkg="zed_components" plugin="stereolabs::ZedCamera"
                       name="$(var zed_camera_name)" namespace="$(var camera_ns)">
        <param from="$(var zed_common_config)"/>
        <param from="$(var zed_model_config)"/>
        <param from="$(var zed_override_config)"/>
        <param name="general.camera_name" value="$(var zed_camera_name)"/>
        <param name="general.camera_model" value="$(var zed_camera_model)"/>
        <!-- Left/right only when they are encoded; see zed.param.yaml. -->
        <param name="video.publish_left_right" value="$(var zed_stereo_video)"/>

        <extra_arg name="use_intra_process_comms" value="true"/>
      </composable_node>
    </load_composable_node>

    <!--
      The stereo encoders, in the ZED's own container. Per side: Isaac's
      format converter takes the wrapper's bgr8 (enable_24bit_output) to the
      rgb8 the encoder subscribes, on the GPU, then the encoder turns it into
      NV12 and H.264. The rgb8 topic is an internal hop; nothing records it.
      Encoder settings are Isaac's defaults (qp 20, an I-frame every 5).
    -->
    <load_composable_node target="$(var camera_ns)/$(var zed_camera_name)/zed_container" if="$(var zed_stereo_video)">
      <composable_node pkg="isaac_ros_image_proc" plugin="nvidia::isaac_ros::image_proc::ImageFormatConverterNode"
                       name="left_rgb8" namespace="$(var camera_ns)/$(var zed_camera_name)">
        <param name="encoding_desired" value="rgb8"/>
        <param name="image_width" value="$(var zed_video_width)"/>
        <param name="image_height" value="$(var zed_video_height)"/>
        <remap from="image_raw" to="left/color/rect/image"/>
        <remap from="image" to="left/color/rect/image_rgb8"/>
      </composable_node>
      <composable_node pkg="isaac_ros_h264_encoder" plugin="nvidia::isaac_ros::h264_encoder::EncoderNode"
                       name="left_h264" namespace="$(var camera_ns)/$(var zed_camera_name)">
        <param name="input_width" value="$(var zed_video_width)"/>
        <param name="input_height" value="$(var zed_video_height)"/>
        <remap from="image_raw" to="left/color/rect/image_rgb8"/>
        <remap from="image_compressed" to="left/color/rect/image/h264"/>
      </composable_node>
      <composable_node pkg="isaac_ros_image_proc" plugin="nvidia::isaac_ros::image_proc::ImageFormatConverterNode"
                       name="right_rgb8" namespace="$(var camera_ns)/$(var zed_camera_name)">
        <param name="encoding_desired" value="rgb8"/>
        <param name="image_width" value="$(var zed_video_width)"/>
        <param name="image_height" value="$(var zed_video_height)"/>
        <remap from="image_raw" to="right/color/rect/image"/>
        <remap from="image" to="right/color/rect/image_rgb8"/>
      </composable_node>
      <composable_node pkg="isaac_ros_h264_encoder" plugin="nvidia::isaac_ros::h264_encoder::EncoderNode"
                       name="right_h264" namespace="$(var camera_ns)/$(var zed_camera_name)">
        <param name="input_width" value="$(var zed_video_width)"/>
        <param name="input_height" value="$(var zed_video_height)"/>
        <remap from="image_raw" to="right/color/rect/image_rgb8"/>
        <remap from="image_compressed" to="right/color/rect/image/h264"/>
      </composable_node>
    </load_composable_node>

    <!--
      Publishes the camera's rigid internal geometry from the vendor URDF:
        zed_camera_link -> zed_camera_center -> zed_left/right_camera_frame
                        -> *_camera_frame_optical

      The driver never publishes these under any configuration, and it consumes
      zed_camera_center -> zed_camera_link via getCamera2BaseTransform(), so
      they have to come from somewhere. Using the vendor xacro keeps the numbers
      out of this repository and ties their lifetime to the driver's.

      The mount point itself, sensor_kit_base_link -> zed_camera_link, is
      Autoware's: see zed_camera_link in sensor_kit_calibration.yaml.
    -->
    <node pkg="robot_state_publisher" exec="robot_state_publisher"
          name="$(var zed_camera_name)_state_publisher"
          namespace="$(var camera_ns)/$(var zed_camera_name)">
      <param name="robot_description"
             value="$(command 'xacro $(find-pkg-share zed_wrapper)/urdf/zed_descr.urdf.xacro camera_name:=$(var zed_camera_name) camera_model:=$(var zed_camera_model)' 'warn')"/>
      <remap from="robot_description" to="$(var zed_camera_name)_description"/>
    </node>
  </group>
</launch>
