<launch>
  <!--
    Single entry point for every camera on the vehicle. The two branches run on
    different machines: the GMSL cameras on the Advantech (reached through
    sensing.launch.xml), the ZED X on the orin (included directly by
    golfcart.launch.yaml, since the sensing subtree is master-only).

    See docs/design/zed_camera_integration.md.
  -->
  <arg name="launch_driver" default="true"/>
  <arg name="camera_model" default="gmslcam" description="gmslcam | zedx | none"/>

  <arg name="use_left_camera" default="true"/>
  <arg name="use_right_camera" default="true"/>
  <arg name="use_rear_camera" default="true"/>

  <!--
    Which capture path the GMSL cameras use: the name of a directory in
    config/camera_capture/. See the README there.

    A launch argument and nothing else. It used to also read
    $(env CAMERA_CAPTURE_PROFILE ...), which made the default depend on whatever
    config/sensors.conf and scripts/env.sh happened to export; the value below is
    now the only default there is, and overriding it means saying so:

        ros2 launch golfcart_sensor_kit_launch camera.launch.xml \
            camera_model:=gmslcam capture_profile:=v4l2-mmap

    Note the route: `just launch` reaches this file through
    tier4_sensing_component.launch.xml and tier4_sensing_launch/sensing.launch.xml,
    installed Autoware files that forward a fixed set of arguments, and
    capture_profile is not among them. Through `just launch` this default is what
    runs. Switching profiles is a launch of this file directly, or an edit here.

    A profile is a directory of three files, one per camera, each keyed `/**`.
    It was one file keyed `/**/camera_left` and friends; rclrs, which gmslcam is
    built on, matches parameter-file node keys literally and never expands that
    wildcard, so a single-file profile would load and silently configure nothing.
  -->
  <arg name="capture_profile" default="nvv4l2camerasrc"/>

  <arg name="zed_camera_name" default="zed"/>

  <!--
    ZED X. No push-ros-namespace in this branch: zed.launch.xml uses absolute
    namespaces because load_composable_node resolves its target before a push
    applies. See the header comment in that file.
  -->
  <group if="$(eval &quot;'$(var camera_model)'=='zedx'&quot;)">
    <include file="$(find-pkg-share golfcart_sensor_kit_launch)/launch/zed.launch.xml" if="$(var launch_driver)">
      <arg name="zed_camera_name" value="$(var zed_camera_name)"/>
      <arg name="zed_camera_model" value="$(var camera_model)"/>
    </include>
  </group>

  <!--
    GMSL cameras: three camera nodes in ONE gmslcam process.

    The process node is only a host. It reads `cameras` and, per key, where
    that camera's node goes and what configures it, then creates the three
    camera nodes on its own executor and drops itself, so the graph shows
    exactly /sensing/camera/{left,right,rear}/camera_{left,right,rear} and one
    gmslcam process. Each camera node reads its camera file (what the camera
    is) and the profile's file for that camera (how pixels reach the encoder)
    as NODE-LOCAL parameter files, and its calibration URL as a node-local
    override, because gmslcam resolves file:// and absolute paths only and a
    parameter file cannot spell $(find-pkg-share).

    The per-camera files must not be passed to the process itself: rclrs
    merges process-level parameter files into every node, so three `/**`
    files given that way would overwrite each other and every camera would be
    the last one. The `<key>.params_files` route is what keeps them apart.

    The namespaces are the host's own namespace plus the key, so the "sensing"
    that sensing.launch.xml is reached under still arrives: image_topic
    "image_raw/compressed" under /sensing/camera/left is
    /sensing/camera/left/image_raw/compressed, as before. No remaps.

    A disabled camera is `<key>.enabled: false`, not a shorter list: launch XML
    cannot build a list conditionally, and the host skips it by name.

    Beside the main pair, every camera node publishes a decimated copy for
    viewers, rviz/image_raw/compressed and rviz/camera_info, every
    frames_per_sample-th frame and only while something subscribes. The rate is
    set in the camera YAMLs; see config/gmslcam.md.
  -->
  <group if="$(eval &quot;'$(var camera_model)'=='gmslcam'&quot;)">
    <push-ros-namespace namespace="camera"/>
    <node pkg="gmslcam" exec="gmslcam" name="gmsl_cameras" output="screen">
      <param name="cameras" type="list_of_str" value="rear,left,right" value-sep=","/>

      <param name="rear.enabled" type="bool" value="$(var use_rear_camera)"/>
      <param name="rear.params_files" type="list_of_str" value-sep=","
             value="$(find-pkg-share golfcart_sensor_kit_launch)/config/camera_rear.yaml,$(find-pkg-share golfcart_sensor_kit_launch)/config/camera_capture/$(var capture_profile)/rear.yaml"/>
      <param name="rear.overrides" type="list_of_str" value-sep=","
             value="camera_info_url:=file://$(find-pkg-share golfcart_sensor_kit_launch)/config/camera_rear_calibration.yaml"/>

      <param name="left.enabled" type="bool" value="$(var use_left_camera)"/>
      <param name="left.params_files" type="list_of_str" value-sep=","
             value="$(find-pkg-share golfcart_sensor_kit_launch)/config/camera_left.yaml,$(find-pkg-share golfcart_sensor_kit_launch)/config/camera_capture/$(var capture_profile)/left.yaml"/>
      <param name="left.overrides" type="list_of_str" value-sep=","
             value="camera_info_url:=file://$(find-pkg-share golfcart_sensor_kit_launch)/config/camera_left_calibration.yaml"/>

      <param name="right.enabled" type="bool" value="$(var use_right_camera)"/>
      <param name="right.params_files" type="list_of_str" value-sep=","
             value="$(find-pkg-share golfcart_sensor_kit_launch)/config/camera_right.yaml,$(find-pkg-share golfcart_sensor_kit_launch)/config/camera_capture/$(var capture_profile)/right.yaml"/>
      <param name="right.overrides" type="list_of_str" value-sep=","
             value="camera_info_url:=file://$(find-pkg-share golfcart_sensor_kit_launch)/config/camera_right_calibration.yaml"/>
    </node>
  </group>
</launch>
