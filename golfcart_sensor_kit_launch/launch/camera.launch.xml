<launch>
  <arg name="launch_driver" default="true"/>
  <!--
  <arg name="enable_stereo_output" default="false" description="Enable left/right stereo output (for Isaac SLAM)"/>
  -->
  <arg name="use_left_camera" default="true"/>
  <arg name="use_right_camera" default="true"/>
  <arg name="use_rear_camera" default="true"/>

  <!-- USB Camera Device Arguments -->
  <!-- Might need to swap the orders -->
  <arg name="rear_camera_device" default="/dev/v4l/by-path/platform-tegra-capture-vi-video-index12"/>
  <arg name="left_camera_device" default="/dev/v4l/by-path/platform-tegra-capture-vi-video-index0"/>
  <arg name="right_camera_device" default="/dev/v4l/by-path/platform-tegra-capture-vi-video-index10"/>

  <!-- USB Cameras Group -->
  <group>
	  <push-ros-namespace namespace="camera"/>

	  <!-- Rear USB Camera -->
	  <group if="$(var use_rear_camera)">
		  <push-ros-namespace namespace="rear"/>
		  <node pkg="gscam" exec="gscam_node" name="usb_camera_rear" output="screen">
			  <param from="$(find-pkg-share golfcart_sensor_kit_launch)/config/usb_camera_rear.yaml"/>
			  <remap from="camera/image_raw" to="image_raw"/>
			  <remap from="camera/camera_info" to="camera_info"/>
		  </node>
	  </group>

	  <!-- Left USB Camera -->
	  <group if="$(var use_left_camera)">
		  <push-ros-namespace namespace="left"/>
		  <node pkg="gscam" exec="gscam_node" name="usb_camera_left" output="screen">
			  <param from="$(find-pkg-share golfcart_sensor_kit_launch)/config/usb_camera_left.yaml"/>
			  <remap from="camera/image_raw" to="image_raw"/>
			  <remap from="camera/camera_info" to="camera_info"/>
		  </node>
	  </group>

	  <!-- Right USB Camera -->
	  <group if="$(var use_right_camera)">
		  <push-ros-namespace namespace="right"/>
		  <node pkg="gscam" exec="gscam_node" name="usb_camera_right" output="screen">
			  <param from="$(find-pkg-share golfcart_sensor_kit_launch)/config/usb_camera_right.yaml"/>
			  <remap from="camera/image_raw" to="image_raw"/>
			  <remap from="camera/camera_info" to="camera_info"/>
		  </node>
	  </group>
  </group>
</launch>
