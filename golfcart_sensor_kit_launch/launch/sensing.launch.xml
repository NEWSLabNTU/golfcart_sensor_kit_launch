<launch>
  <arg name="launch_driver" default="true" description="do launch driver"/>
  <arg name="vehicle_mirror_param_file" description="path to the file of vehicle mirror position yaml"/>
  <arg name="pointcloud_container_name" default="pointcloud_container"/>
  <arg name="vehicle_id" default="$(env VEHICLE_ID default)"/>
  <!--
    Plain launch arguments with plain defaults, no environment. golfcart_launch
    reaches this file through its own copy of tier4_sensing_component.launch.xml,
    which passes every one of these by name; the installed Autoware pair
    (tier4_sensing_component, tier4_sensing_launch/sensing.launch.xml) forwarded
    four arguments and dropped the rest, which is why these used to read
    CAMERA_MODEL, IMU_SOURCE, GNSS_RECEIVER, USE_NTRIP and POINTCLOUD_BACKEND.
    Through that installed pair these defaults are what runs.

    imu_source defaults to zed: the Xsens MTi is broken and publishes nothing.
  -->
  <arg name="camera_model" default="gmslcam" description="gmslcam | zedx | none"/>
  <arg name="capture_profile" default="nvv4l2camerasrc" description="GMSL capture profile, a directory in config/camera_capture/"/>
  <arg name="imu_source" default="zed" description="zed | xsens"/>
  <arg name="gnss_receiver" default="ublox" description="ublox | septentrio | none"/>
  <arg name="use_ntrip" default="false" description="launch the NTRIP client and feed RTCM to the receiver"/>
  <!--
    Which concatenator runs: the CPU one from autoware_pointcloud_preprocessor,
    or the CUDA one from autoware_cuda_pointcloud_preprocessor. Same parameter
    file, same node name, same topics either way.

    Before switching, read docs/research/sensing/lidar-pipeline-starvation.md:
    concatenation measured 12.5 ms against a 510 ms pipeline latency, so this is
    not where the delay is.
  -->
  <arg name="pointcloud_backend" default="cuda" description="cpu | cuda"/>

  <group>
    <!-- LiDAR Driver -->
    <include file="$(find-pkg-share golfcart_sensor_kit_launch)/launch/lidar.launch.xml">
      <arg name="launch_driver" value="$(var launch_driver)"/>
      <arg name="vehicle_mirror_param_file" value="$(var vehicle_mirror_param_file)"/>
      <arg name="pointcloud_container_name" value="$(var pointcloud_container_name)"/>
      <arg name="pointcloud_backend" value="$(var pointcloud_backend)"/>
    </include>

    <!-- Camera Driver -->
    <include file="$(find-pkg-share golfcart_sensor_kit_launch)/launch/camera.launch.xml">
      <arg name="launch_driver" value="$(var launch_driver)" />
      <arg name="camera_model" value="$(var camera_model)"/>
      <arg name="capture_profile" value="$(var capture_profile)"/>
    </include>

    <!-- IMU Driver -->
    <include file="$(find-pkg-share golfcart_sensor_kit_launch)/launch/imu.launch.xml">
      <arg name="launch_driver" value="$(var launch_driver)"/>
      <arg name="vehicle_id" value="$(var vehicle_id)"/>
      <arg name="imu_source" value="$(var imu_source)"/>
    </include>

    <!-- GNSS Driver -->
    <include file="$(find-pkg-share golfcart_sensor_kit_launch)/launch/gnss.launch.xml">
      <arg name="launch_driver" value="$(var launch_driver)"/>
      <arg name="gnss_receiver" value="$(var gnss_receiver)"/>
      <arg name="use_ntrip" value="$(var use_ntrip)"/>
    </include>

    <!-- Vehicle Velocity Converter  -->
    <include file="$(find-pkg-share autoware_vehicle_velocity_converter)/launch/vehicle_velocity_converter.launch.xml">
      <arg name="input_vehicle_velocity_topic" value="/vehicle/status/velocity_status"/>
      <arg name="output_twist_with_covariance" value="/sensing/vehicle_velocity_converter/twist_with_covariance"/>
    </include>
  </group>
</launch>
