<launch>
  <arg name="launch_driver" default="true"/>
  <!-- <arg name="host_ip" default="192.168.26.1"/> -->
  <arg name="use_concat_filter" default="true"/>
  <arg name="vehicle_id" default="$(env VEHICLE_ID default)"/>
  <arg name="vehicle_mirror_param_file"/>
  <arg name="pointcloud_container_name" default="pointcloud_container"/>
  <arg name="vlp32c_device_ip" default="192.168.7.10"/>
  <!-- Nebula's Velodyne launch file and the VLP-32C calibration it decodes
       with. Both moved between Autoware releases (nebula_ros and
       nebula_decoders in 1.5.0; nebula_velodyne and nebula_velodyne_decoders
       from 2.1.0, Nebula 1.2), so they are arguments: the defaults are 1.5.0's,
       and golfcart_launch on its 2.1.0 branch passes the new ones. This keeps
       one source of the sensor kit for every Autoware version.
       config/VLP32.param.yaml reads the calibration through $(var ...). -->
  <arg name="nebula_velodyne_launch_file" default="$(find-pkg-share nebula_ros)/launch/velodyne_launch_all_hw.xml"/>
  <arg name="vlp32_calibration_file" default="$(find-pkg-share nebula_decoders)/calibration/velodyne/VLP32.yaml"/>
  <!-- cpu | cuda. Same default as sensing.launch.xml, so invoking this file
       directly behaves the same way. -->
  <arg name="pointcloud_backend" default="cuda" description="cpu | cuda"/>

  <group>
    <push-ros-namespace namespace="lidar"/>

    <group>
        <push-ros-namespace namespace="vlp32"/>
        <include file="$(var nebula_velodyne_launch_file)" if="$(var launch_driver)">
          <arg name="sensor_model" value="VLP32" />
          <arg name="launch_hw" value="true" />
          <arg name="config_file" value="$(find-pkg-share golfcart_sensor_kit_launch)/config/VLP32.param.yaml" />
        </include>
    </group>

    <group>
        <push-ros-namespace namespace="falcon"/>
        <!-- Guarded like the Velodyne above. Without it the Seyond driver starts
             even when launch_driver is false, which is exactly when no hardware
             is meant to be opened: a logging simulation replaying a bag. It then
             spends the run retrying an HTTP connection to 172.168.1.10 and
             filling the log with timeouts, while the point cloud it would have
             produced is coming from the bag anyway. -->
        <include file="$(find-pkg-share golfcart_sensor_kit_launch)/launch/seyond_start.py"
                 if="$(var launch_driver)">
          <!-- <arg name="config_path" value="$(find-pkg-share seyond)/config/seyond.param.yaml"/> -->
        </include>
    </group>

    <include file="$(find-pkg-share golfcart_sensor_kit_launch)/launch/pointcloud_preprocessor.launch.py">
      <arg name="base_frame" value="base_link"/>
      <arg name="use_intra_process" value="true"/>
      <arg name="use_multithread" value="true"/>
      <arg name="pointcloud_container_name" value="$(var pointcloud_container_name)"/>
      <arg name="pointcloud_backend" value="$(var pointcloud_backend)"/>
    </include>
  </group>
</launch>
