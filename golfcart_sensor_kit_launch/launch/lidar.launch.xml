<launch>
  <arg name="launch_driver" default="true"/>
  <!-- <arg name="host_ip" default="192.168.26.1"/> -->
  <arg name="use_concat_filter" default="true"/>
  <arg name="vehicle_id" default="$(env VEHICLE_ID default)"/>
  <arg name="vehicle_mirror_param_file"/>
  <arg name="pointcloud_container_name" default="pointcloud_container"/>
  <arg name="vlp32c_device_ip" default="192.168.7.10"/>
  <!-- cpu | cuda. Declared with the same env default as the caller so that
       invoking this file directly behaves the same way. -->
  <arg name="pointcloud_backend" default="$(env POINTCLOUD_BACKEND cuda)" description="cpu | cuda"/>

  <!--
    Which host runs the two LiDAR drivers: master (the default, unchanged
    behaviour) or orin. config/sensors.conf holds LIDAR_HOST, same mechanism
    as IMU_SOURCE / CAMERA_MODEL and for the same reason - see
    config/README.md.

    Preprocessing and concatenation below are NOT gated on this: only the raw
    drivers move, and they always stay on the master regardless of where
    LIDAR_HOST points, consuming whichever host published
    /sensing/lidar/{vlp32,falcon}/... over DDS.
  -->
  <arg name="lidar_host" default="$(env LIDAR_HOST master)" description="master | orin - which host runs the LiDAR drivers"/>

  <group>
    <push-ros-namespace namespace="lidar"/>

    <include file="$(find-pkg-share golfcart_sensor_kit_launch)/launch/lidar_driver.launch.xml"
             if="$(eval &quot;'$(var lidar_host)'=='master'&quot;)">
      <arg name="launch_driver" value="$(var launch_driver)"/>
      <arg name="vlp32c_device_ip" value="$(var vlp32c_device_ip)"/>
    </include>

    <include file="$(find-pkg-share golfcart_sensor_kit_launch)/launch/pointcloud_preprocessor.launch.py">
      <arg name="base_frame" value="base_link"/>
      <arg name="use_intra_process" value="true"/>
      <arg name="use_multithread" value="true"/>
      <arg name="pointcloud_container_name" value="$(var pointcloud_container_name)"/>
      <arg name="pointcloud_backend" value="$(var pointcloud_backend)"/>
    </include>
  </group>
</launch>
