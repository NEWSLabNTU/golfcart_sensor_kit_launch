<launch>
  <arg name="launch_driver" default="true"/>
  <!--
    `none` exists because the receiver is not on every host. The u-blox is
    cabled to the orin (the oToCam overlay took the Advantech's USB ports), but
    both hosts launched this node, so the Advantech spent every run failing:

      terminate called after throwing an instance of 'std::runtime_error'
        what():  U-Blox: Could not open serial port :/dev/ublox-gps
                 open: No such file or directory

    with `respawn="true" respawn_delay="1.0"` restarting it forever. Each
    restart re-registers the name the orin's node already holds, which is what
    duplicated_node_checker reports as
    `Duplicated nodes detected[/sensing/gnss/ublox]` (1131 times in the
    2026-08-25 observable run). Set GNSS_RECEIVER=none in config/sensors.conf on
    the host without the receiver.
  -->
  <arg name="gnss_receiver" default="$(env GNSS_RECEIVER ublox)" description="ublox(default) | septentrio | none"/>

  <!--
    RTK corrections over NTRIP, u-blox only. Read from the environment for the
    same reason gnss_receiver is: the sensing chain between golfcart.launch.yaml
    and this file is two installed Autoware files that forward a fixed argument
    list, so `use_ntrip:=true` reaches golfcart_autoware.launch.xml and stops.
    golfcart.launch.yaml set_env's USE_NTRIP from its own use_ntrip argument
    immediately before the include, the way it does POINTCLOUD_BACKEND, so the
    argument works from the command line; nothing needs USE_NTRIP in a shell.

    The caster (host, port, mountpoint) is in config/ntrip_client.param.yaml
    here. The account is not: every e-GNSS mountpoint authenticates, and the
    credentials belong to the lab, so they live in the parent repo's gitignored
    config/ntrip.param.yaml, which scripts/env.sh exports as NTRIP_PARAM_FILE
    when it exists. Without it the kit's own file loads, with empty username and
    password, and the client exits on start naming the parameter it is missing.
  -->
  <arg name="use_ntrip" default="$(env USE_NTRIP false)" description="launch the NTRIP client and feed RTCM to the receiver"/>
  <arg name="ntrip_param_file"
       default="$(env NTRIP_PARAM_FILE $(find-pkg-share golfcart_sensor_kit_launch)/config/ntrip_client.param.yaml)"/>

  <group>
    <push-ros-namespace namespace="gnss"/>

    <!--
      Switch topic name. One unconditional <let>, not one per receiver guarded by
      `if`: a conditional <let> defines the configuration only on the branch that
      fires, and play_launch's parser walks on to the consumers below regardless,
      dying with

        Undefined variable: 'navsatfix_topic_name'

      before any node starts. `ros2 launch` tolerates it, so this only ever broke
      through `just launch` / golfcart-launch.service. Same fix as imu.launch.xml.

      The dict lookup raises KeyError naming an unknown receiver rather than
      silently picking one, which would point Autoware at a topic nothing
      publishes.
    -->
    <let name="navsatfix_topic_name"
         value="$(eval &quot;{'ublox': 'ublox/nav_sat_fix', 'septentrio': 'septentrio/nav_sat_fix', 'none': 'ublox/nav_sat_fix'}['$(var gnss_receiver)']&quot;)"/>
    <let name="orientation_topic_name" value="/autoware_orientation"/>

    <!--
      u-blox ZED-F9P. `ublox_gps` is built from source, from the ublox_f9p_ws
      submodule under src/sensor_component/external, not from the apt
      ros-humble-ublox-gps that used to satisfy the same package name. The two
      differ in one thing that matters here: the fork takes its RTCM input as
      mavros_msgs/RTCM, which is what the ntrip_client in the same workspace
      publishes, where the apt build wants rtcm_msgs/Message.

      Topic layout, all relative so the tree can be re-namespaced:

        ~/fix        to  ~/nav_sat_fix         what gnss_poser reads
        nmea         to  ~/nmea_sentence       GGA and friends; the NTRIP client
                                               uplinks these, the VRS caster
                                               needs them to place its base
        /rtcm        to  ntrip/rtcm            the driver subscribes to an
                                               ABSOLUTE /rtcm in code, so the
                                               remap has to name it absolutely
        rxmrtcm      to  ~/rxmrtcm             UBX-RXM-RTCM: which corrections
                                               the receiver accepted

      Those are the names golfcart_system_monitor's monitor_topics.yaml already
      lists, so with use_ntrip on they stop being placeholders.
    -->
    <group if="$(eval &quot;'$(var gnss_receiver)'=='ublox'&quot;)">
      <node pkg="ublox_gps" name="ublox" exec="ublox_gps_node" if="$(var launch_driver)" respawn="true" respawn_delay="1.0">
        <remap from="~/fix" to="~/nav_sat_fix"/>
        <remap from="nmea" to="~/nmea_sentence"/>
        <remap from="/rtcm" to="ntrip/rtcm"/>
        <remap from="rxmrtcm" to="~/rxmrtcm"/>
        <param from="$(find-pkg-share golfcart_sensor_kit_launch)/config/ublox_f9p.yaml"/>
      </node>

      <!--
        NTRIP client, from the same workspace (LORD-MicroStrain's, vendored).
        Same namespace as the driver so both remaps stay relative: it publishes
        `rtcm` and subscribes `nmea`, and both are moved onto the names above.

        respawn is deliberate and slow. A caster that is down, or wrong
        credentials, makes the node exit after a TCP timeout of up to ~130 s, so
        a fast respawn would only hammer the caster; a dropped connection on a
        working account is what the respawn is for.
      -->
      <node pkg="ntrip_client" name="ntrip_client" exec="ntrip_ros.py" output="screen"
            if="$(eval &quot;'$(var launch_driver)'=='true' and '$(var use_ntrip)'=='true'&quot;)"
            respawn="true" respawn_delay="5.0">
        <remap from="rtcm" to="ntrip/rtcm"/>
        <remap from="nmea" to="ublox/nmea_sentence"/>
        <param from="$(var ntrip_param_file)"/>
      </node>
    </group>

    <!--
      Septentrio GNSS Driver. Both operands are compared, not just the second:
      `'false' and X` in Python is X, because a non-empty string is truthy, so
      the previous `'$(var launch_driver)' and ...` launched the driver with
      launch_driver:=false whenever the receiver was septentrio.
    -->
    <group if="$(eval &quot;'$(var launch_driver)'=='true' and '$(var gnss_receiver)'=='septentrio'&quot;)">
      <include file="$(find-pkg-share septentrio_gnss_driver)/launch/mosaic_x5_rover.launch.xml"/>
    </group>

    <!-- NavSatFix to MGRS Pose -->
    <include file="$(find-pkg-share autoware_gnss_poser)/launch/gnss_poser.launch.xml">
      <arg name="input_topic_fix" value="$(var navsatfix_topic_name)"/>
      <arg name="input_topic_orientation" value="$(var orientation_topic_name)"/>

      <arg name="output_topic_gnss_pose" value="pose"/>
      <arg name="output_topic_gnss_pose_cov" value="pose_with_covariance"/>
      <arg name="output_topic_gnss_fixed" value="fixed"/>

      <!-- use_gnss_ins_orientation is NOT settable from here, and passing it was
           doing nothing. gnss_poser.launch.xml does not declare it, and it loads
           its parameter file without allow_substs, so the name could not reach
           the parameter even if it appeared there. It is a node parameter: to
           change it, point param_file at a copy of
           autoware_gnss_poser/config/gnss_poser.param.yaml with the value
           edited.

           The package default is already true, so removing the line changes no
           behaviour. Worth knowing separately: nothing on this vehicle publishes
           /autoware_orientation, so there is no INS orientation for the setting
           to use either way. -->
    </include>
  </group>
</launch>
